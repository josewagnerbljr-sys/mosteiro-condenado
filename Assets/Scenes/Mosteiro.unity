  m_Script: {fileID: 11500000, guid: 9d369c7f812cf1c48b5b6b188e5721d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MongeArcano.Coletavel
  tipo: 3
  chaveId: 
  titulo: "Ora\xE7\xE3o Rasgada"
  texto: "Os espectros dos irm\xE3os mortos rondam a Capela. A ess\xEAncia azul do cajado os dispersa.\n\nA Chave de Ferro, que abre a Biblioteca, deixei sobre o pedestal junto ao altar. O Sigilo da Lua repousa na parede oeste; os espectros o guardam.\n\nReze no altar para restaurar as for\xE7as. \xC9 o \xFAnico lugar seguro."
  valor: 5
  automatico: 0
