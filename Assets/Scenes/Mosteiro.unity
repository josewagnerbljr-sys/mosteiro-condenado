  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d369c7f812cf1c48b5b6b188e5721d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MongeArcano.Coletavel
  tipo: 3
  chaveId: 
  titulo: "Di\xE1rio do Abade"
  texto: "Terceira lua ap\xF3s o ritual falho. Os irm\xE3os j\xE1 n\xE3o dormem: ouvem um canto vindo das catacumbas.\n\nSelei o Santu\xE1rio com os Tr\xEAs Sigilos - Lua, Fogo e Terra - e escondi cada um nos sal\xF5es do mosteiro. Quem os reunir poder\xE1 abrir o port\xE3o... ou libertar o que dorme l\xE1 dentro.\n\nA Capela, a oeste, ainda \xE9 terra consagrada. Que a luz me perdoe.\n\n- Abade Iram"
  valor: 5
  automatico: 0
