  m_Script: {fileID: 11500000, guid: 9d369c7f812cf1c48b5b6b188e5721d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MongeArcano.Coletavel
  tipo: 3
  chaveId: 
  titulo: "Registro do Bibliotec\xE1rio"
  texto: "Os possu\xEDdos vagam entre as estantes, repetindo versos que n\xE3o entendem.\n\nA Chave de Osso, que abre as Catacumbas, est\xE1 na parede leste. O Sigilo do Fogo queima sobre a mesa - n\xE3o o toque sem estar preparado.\n\n- Bibliotec\xE1rio Anselmo"
  valor: 5
  automatico: 0
