  m_Script: {fileID: 11500000, guid: 7d07ed41642fada429f06d8e37d4c8ef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MongeArcano.NpcFalante
  nome: Mensageiro
  fala: "[Texto provis\xF3rio - a hist\xF3ria ser\xE1 escrita pelo autor]\n\nBem-vindo ao Mosteiro de N\xE9voa Negra, monge. Poucos chegam at\xE9 aqui sem perder a esperan\xE7a.\n\nSiga o caminho entre os t\xFAmulos. Os mortos n\xE3o descansam nesta terra, e o que dorme dentro do mosteiro \xE9 pior.\n\nReze no altar antes de seguir. Ele guardar\xE1 o seu progresso."
  alvoCamera: {fileID: 1463439510}
